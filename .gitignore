# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# dados locais do app self-hosted (financeiro pessoal real, nunca deve ir pro repo)
/data/*
!/data/.gitkeep

# superpowers
/.superpowers/

# planos/specs internos de agente de IA (não são conteúdo pro repositório público)
/docs/superpowers/

# worktrees (scratch, git-ignored)
/.worktrees/

# handoff local (contém caminho local do usuário)
HANDOFF.md

# configuração local do Claude Code (pode conter caminhos locais)
/.claude/

# screenshots temporários de verificação visual
/.tmp/
