# Modo da aplicação: deixe vazio para self-hosted (padrão) ou "demo" para o modo hospedado
NEXT_PUBLIC_APP_MODE=

# Provedor de IA: "ollama" (padrão, requer `ollama serve` local) ou "groq"
AI_PROVIDER=

# Necessário só quando AI_PROVIDER=groq — gere gratuitamente em https://console.groq.com
GROQ_API_KEY=
